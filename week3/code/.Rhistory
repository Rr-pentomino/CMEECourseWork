) +
theme_minimal()
# Create Data Frame for Rainfall
rainfall_data <- data.frame(day = 1:days, rainfall = rainfall)
# Plot Rainfall Over Time
ggplot(rainfall_data, aes(x = day, y = rainfall)) +
geom_line(color = "blue", size = 1) +
labs(
title = "Daily Rainfall Over One Year",
x = "Month",
y = "Rainfall (mm)"
) +
scale_x_continuous(
breaks = c(1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335),
labels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
) +
theme_minimal()
wilting_point <- 10  # Minimum soil moisture before stress
field_capacity <- 40  # Soil can hold up to 50% water before draining
uptake_efficiency <- 0.3  # Base root uptake efficiency
evap_base <- 1.5  # Baseline evapotranspiration
evap_sensitivity <- 0.05  # Temperature effect on evaporation
drainage_coefficient <- 0.2  # Base drainage rate
T_opt <- 20
k <- 0.1
# Initialize Soil Moisture & Fungal Colonization Vectors
soil_moisture <- numeric(days)
fungi_colonization <- rep(initial_fungi_colonization, days)  # Assume constant colonization for now
soil_moisture[1] <- initial_soil_moisture
rainfall_effect <- numeric(days)
evapotranspiration <- numeric(days)
root_uptake <- numeric(days)
drainage <- numeric(days)
K <- 5
# Soil Moisture Simülasyonu
for (t in 1:(days - 1)) {
# 1️⃣ Yağmurun Soil Moisture’a Etkisi
rainfall_effect[t] <- rainfall[t]
T_effect <- 2 + (1 / (1 + exp(-k * (temperature[t] - T_opt))))  # 2.3 ile 3.3 arasında değişir
# 📌 EVAPOTRANSPİRASYON HESAPLAMASI
evapotranspiration[t] <- max(evap_base + evap_sensitivity * (temperature[t] - 10), 0) *
T_effect * (soil_moisture[t] / 100)
# 3️⃣ Root Uptake (Bitki Su Alımı)
fungal_factor <- (0.5 + fungi_colonization[t] / 100)
root_uptake[t] <- (uptake_efficiency * soil_moisture[t] * fungal_factor) / (soil_moisture[t] + 15)
#DRENAJ HESAPLAMASI
excess_water <- max(0, soil_moisture[t] - field_capacity)
drainage[t] <- K * (excess_water / 100)
# 5️⃣ Soil Moisture Güncellemesi
soil_moisture[t+1] <- soil_moisture[t] + rainfall_effect[t] - evapotranspiration[t] - root_uptake[t] - drainage[t]
# 6️⃣ Realistik Değer Sınırları
soil_moisture[t+1] <- min(max(soil_moisture[t+1], wilting_point), 100)
}
# Create Data Frame for Visualization
soil_moisture_data <- data.frame(day = 1:days, soil_moisture = soil_moisture)
# Plot Soil Moisture Over Time
library(ggplot2)
ggplot(soil_moisture_data, aes(x = day, y = soil_moisture)) +
geom_line(color = "blue", size = 1) +
labs(
title = "Daily Soil Moisture with Maximum Cap at 100%",
x = "Month",
y = "Soil Moisture (%)"
) +
scale_x_continuous(
breaks = c(1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335),
labels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
) +
theme_minimal()
temp_effect <- numeric(days)
k_S <- 40000000
# Gaussian sıcaklık etkisi fonksiyonu
gaussian_temp_effect <- function(temperature, T_opt = 20, sigma = 4) {
return(exp(-((temperature - T_opt)^2) / (2 * sigma^2)))
}
# Sap Flow modeli (Toprak Nemi + Sıcaklık + Mikorizal Etki)
sap_flow_calc <- function(root_uptake, temperature, k_S) {
temp_effect <- gaussian_temp_effect(temperature)
return(k_S * root_uptake * temp_effect)
}
# Sap Flow için boş vektör oluştur
sap_flow <- numeric(days)
# Sap Flow Hesaplama
for (t in 1:(days - 1)) {
temp_effect[t] <- gaussian_temp_effect(temperature[t])
# Sap Flow hesapla
sap_flow[t] <- sap_flow_calc(root_uptake[t], temp_effect[t], k_S)
}
# Son gün eksik kalmasın
sap_flow[days] <- sap_flow[days - 1]
# 14 Günlük Hareketli Ortalama Sap Flow Hesaplama
smoothed_sap_flow <- zoo::rollmean(sap_flow, k = 7, fill = NA, align = "right")
# Sap Flow Zaman Serisi Grafiği
ggplot(data.frame(day = 1:days, sap_flow = sap_flow, smoothed_sap_flow = smoothed_sap_flow), aes(x = day)) +
geom_line(aes(y = sap_flow), color = "lightblue", alpha = 0.5) +
geom_line(aes(y = smoothed_sap_flow), color = "blue", size = 1) +
labs(
title = "Smoothed Sap Flow Over One Year (14-day Moving Average)",
x = "Month",
y = "Sap Flow (L/day)"
) +
scale_x_continuous(
breaks = c(1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335),
labels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
) +
theme_minimal()
# Bark Expansion Parameter
expansion_temp_threshold <- 12
base_efficiency <- 0.3
base_shrinkage_threshold <- 40     # Orijinal değer
gamma <- 2                         # Fungi eksikse daha hassas
delta <- 5
shrinkage_sapflow_threshold <- 40
shrinkage_moisture_threshold <- base_shrinkage_threshold +
gamma * (1 - initial_fungi_colonization / 100) +
delta * (1 - uptake_efficiency / base_efficiency)
beta <- 50
expansion_moisture_threshold <- base_threshold -
alpha * initial_fungi_colonization -
beta * (uptake_efficiency - base_efficiency)
expansion_sapflow_threshold <- 60
bark_expansion_coefficient <- 0.6
bark_shrinkage_coefficient <- 0.08
min_temp_threshold <- 10
shrinkage_temp_threshold <- 5
initial_bark_size <- 10
T_opt_bark <- 20
sigma_bark <- 6
global_min_flow <- 10  # Gözlemsel alt sınır
global_max_flow <- 250  # Gözlemsel üst sınır
bark_expansion <- numeric(days)
bark_shrinkage <- numeric(days)
temp_growth_factor <- numeric(days)
moisture_growth_factor <- numeric(days)
adjusted_sap_flow <- numeric(days)
temp_shrink_factor <- numeric(days)
moisture_shrink_factor <- numeric(days)
moisture_shrinkage_response <- function(soil_moisture, threshold = shrinkage_moisture_threshold, slope = 5) {
return(1 / (1 + exp((soil_moisture - threshold) / slope)))
}
# Sap flow transformation with scaling
vector_sigmoid_sap_flow <- function(sap_flow_vec, min_flow, max_flow, k = 0.1, scale_factor = 2) {
normalized <- (sap_flow_vec - min_flow) / (max_flow - min_flow)
scaled <- (normalized - 0.5) * 4
sigmoid <- 1 / (1 + exp(-k * scaled))
return(sigmoid * scale_factor)
}
# Bark dynamics loop ----------------------------------------
for (t in 1:(days - 1)) {
# Expansion scaling components
temp_growth_factor[t] <- gaussian_temp_effect(temperature[t], T_opt = T_opt_bark, sigma = sigma_bark)
moisture_growth_factor[t] <- 1 / (1 + exp(-(soil_moisture[t] - expansion_moisture_threshold) / 5))
adjusted_sap_flow <- vector_sigmoid_sap_flow(
sap_flow_vec = sap_flow,
min_flow = global_min_flow,
max_flow = global_max_flow,
scale_factor = 2
)
# ✅ Expansion only if all three conditions are met
if (temperature[t] > expansion_temp_threshold &&
soil_moisture[t] > expansion_moisture_threshold &&
sap_flow[t] > expansion_sapflow_threshold) {
bark_expansion[t] <- bark_expansion_coefficient *
adjusted_sap_flow[t] *
temp_growth_factor[t] *
moisture_growth_factor[t]
} else {
bark_expansion[t] <- 0
}
# 🌡️ Temperature shrink factor
if (temperature[t] < shrinkage_temp_threshold &&
soil_moisture[t] < shrinkage_moisture_threshold) {
total_shrink_effect <- max(
0.1,
1 - (temperature[t] / shrinkage_temp_threshold),
moisture_shrinkage_response(soil_moisture[t])
)
bark_shrinkage[t] <- bark_shrinkage_coefficient * total_shrink_effect
} else {
bark_shrinkage[t] <- 0
}
}
bark_expansion[days] <- bark_expansion[days - 1]
bark_shrinkage[days] <- bark_shrinkage[days - 1]
bark_growth_cumulative <- initial_bark_size + cumsum(bark_expansion - bark_shrinkage)
bark_growth_cumulative_smoothed <- initial_bark_size + cumsum(rollmean(bark_expansion - bark_shrinkage, k = 14, fill = NA, align = "center"))
bark_growth_data <- data.frame(day = 1:days,
bark_growth_cumulative = bark_growth_cumulative,
bark_growth_cumulative_smoothed = bark_growth_cumulative_smoothed)
ggplot(bark_growth_data, aes(x = day)) +
geom_line(aes(y = bark_growth_cumulative), color = "brown", alpha = 0.4) +
geom_line(aes(y = bark_growth_cumulative_smoothed), color = "darkred", size = 1.2) +
labs(
title = "Cumulative Bark Growth with Shrinkage",
x = "Month",
y = "Total Bark Size (mm)"
) +
scale_x_continuous(
breaks = c(1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335),  # Yaklaşık ay başları
labels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
) +
theme_minimal()
